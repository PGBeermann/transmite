# ===== Clase en Vivo UNACHI — variables del MODO VPS =====
# Cópielas en la pestaña "Environment" de Dokploy (no suba .env a GitHub).

# URL pública con HTTPS (el dominio configurado en Dokploy/Traefik)
CLASE_URL_PUBLICA=https://clase.midominio.edu.pa

# IP pública del VPS (se anuncia a los navegadores para el tráfico de video UDP/TCP 8189)
CLASE_IP_PUBLICA=203.0.113.10

# Contraseña del panel del profesor (mínimo 10 caracteres; use una frase larga)
CLASE_PASSWORD_PROFESOR=cambie-esta-frase-larga

# Opcional: código que deben escribir los estudiantes. El QR del panel ya lo incluye.
# Vacío = cualquiera con el enlace puede ver la clase.
CLASE_CLAVE_ESTUDIANTES=

# Opcional: token para transmitir desde OBS Studio (WHIP, "Bearer Token")
CLASE_TOKEN_OBS=

# Opcional: secreto para firmar sesiones (así sobreviven a un redeploy).
# Genérelo con:  python3 -c "import secrets; print(secrets.token_hex(32))"
CLASE_SECRETO=
